{
  "name": "@commonfabric/api",
  "tasks": {
    // --no-check: this package is type-checked by `deno task check` (tasks/check.sh).
    // The baseline profile keeps the TypeScript wrapper and path mappings covered.
    "test": "deno run --allow-env --allow-read --allow-run=$(deno eval \"console.log(Deno.execPath())\") ../../tasks/run-member-tests.ts deno-test perf-baseline",
    // No path: the walk is what finds every test file, and two of this
    // package's sit beside the sources they exercise rather than under
    // `test/`, which a glob naming that directory passed over.
    "deno-test": "deno test --no-check --allow-read",
    // The type-performance baseline, which is not a test and records
    // nothing. It runs after the tests, so a package whose tests are
    // broken is not also measured.
    "perf-baseline": "deno run -A perf/run-tsc.ts --project perf/tsconfig.baseline.json --pretty false",
    "profile-types": "deno run -A perf/run-benchmarks.ts"
  },
  "imports": {
    // Dependency guide: ../../docs/development/DEPENDENCIES.md
    "typescript": "npm:typescript@6.0.3"
  },
  "exports": {
    ".": "./index.ts",
    "./cfc-authoring": "./cfc-authoring.ts",
    "./cfc": "./cfc.ts",
    "./schema": "./schema.ts"
  }
}
