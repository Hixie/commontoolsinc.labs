{
  // Dependency guide: ../docs/development/DEPENDENCIES.md
  "imports": {
    "@std/yaml": "jsr:@std/yaml@^1.0.12",
    "typescript": "npm:typescript@6.0.3"
  },
  "tasks": {
    "test": "deno run --allow-read --allow-run=\"$(deno eval \"console.log(Deno.execPath())\")\" ./run-member-tests.ts deno-test",
    // --no-check: tasks/ is type-checked by the root `deno task check` job.
    "deno-test": "deno test --no-check -A --shuffle=$(deno task -q test-seed)"
  },
  "test": {
    // `test.ts` is the entry point of the root `deno task test` rather than a
    // test module. It is named that way so `deno coverage` skips it, and the
    // same name is what Deno's test discovery picks up, so it says here that
    // this one is not a test.
    "exclude": ["test.ts"]
  }
}
